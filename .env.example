NEXT_PUBLIC_SANITY_DATASET="sanity-dataset"
NEXT_PUBLIC_SANITY_PROJECT_ID="sanity-project-id"
SANITY_STUDIO_PREVIEW_SECRET="sanity-studio-preview-secret"
SANITY_API_READ_TOKEN="sanity-api-read-token"

# Tellian Capital client portal — used by the "Login" button in Navigation.tsx.
NEXT_PUBLIC_LOGIN_URL="https://telliancapitalportal.9a8da0f.deploio.app/login"

# AWS SES — server-side only (never expose to the client)
AWS_SES_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL="no-reply@example.com"
SES_TO_EMAIL="contact@example.com"
