NEXT_PUBLIC_SANITY_DATASET="sanity-dataset"
NEXT_PUBLIC_SANITY_PROJECT_ID="sanity-project-id"
SANITY_STUDIO_PREVIEW_SECRET="sanity-studio-preview-secret"
SANITY_API_READ_TOKEN="sanity-api-read-token"

# Multi-Zones: own URL of the Solutions Vercel project; this site rewrites
# /solutions and /solutions/* there (next.config.ts). Local: http://localhost:3100
SOLUTIONS_URL=solution-web-url
# Where "Solutions" links point. Default (unset) is the same-domain path /solutions.
# NEXT_PUBLIC_SOLUTIONS_URL="/solutions"

# Public site URL for canonical/sitemap/OG/JSON-LD. Default (unset): https://telliancapital.ch
# NEXT_PUBLIC_SITE_URL="https://telliancapital.ch"

# Tellian Capital client portal — used by the "Login" button in Navigation.tsx.
NEXT_PUBLIC_LOGIN_URL=solution-web-login-url

# Brevo (contact form email) — server-side only (never expose to the client)
BREVO_API_KEY="<BREVO_API_KEY>"
EMAIL_FROM="no-reply@example.com"
EMAIL_FROM_NAME="Tellian Capital"
EMAIL_TO="contact@example.com"
